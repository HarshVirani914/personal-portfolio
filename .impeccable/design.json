      "name": "Ask Bar",
      "kind": "input",
      "refersTo": "ask-bar",
      "description": "Signature entry to the agent overlay.",
      "html": "<button class=\"ds-ask\"><span>Ask me anything</span><i></i></button>",
      "css": ".ds-ask{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:56px;padding:0 20px;border:1px solid var(--ink,#141414);border-radius:9999px;background:var(--bg,#f2f2f0);color:var(--ink,#141414);font:15px/1.5 Geist,sans-serif;cursor:pointer}.ds-ask i{width:8px;height:8px;border-radius:50%;background:var(--agent,#2b4cc8)}.ds-ask:focus-visible{outline:2px solid var(--agent,#2b4cc8);outline-offset:3px}"
    },
