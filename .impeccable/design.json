  "narrative": {
    "northStar": "The Quiet Instrument",
    "overview": "The site behaves like a precise tool at rest. Paper or night, one ink, hairlines, and very large serif type do the talking. Nothing competes with the name in the first viewport, and nothing moves without a reason. The agent is the single live signal on the page: its blue is the only color that belongs to the site as a whole.\n\nDensity is low and the pace is editorial. Large type carries claims, and small mono carries evidence such as dates, coordinates, kinds and counts. Components are quiet until touched: flat rows and pills at rest, with movement and color arriving only on hover, focus or use.\n\nMotion is measured. Type rises through a mask once on arrival, rows shift a few pixels, and statements ink in word by word. Reduced motion and script-free visits get the same content as plain, static text.",
    "keyCharacteristics": [
      "One serif voice for claims, one mono voice for evidence, one sans for reading.",
      "Near-neutral paper and night, with a single agent blue.",
      "Hairlines for structure, with almost no shadow.",
      "Project color appears only inside that project's row and page.",
      "Light and dark are equal themes, and both are built from the same tokens."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Agent blue means the agent or the keyboard focus. Never use it for decoration.",
        "section": "colors"
      },
      {
        "name": "The Contained Accent Rule",
        "body": "A project's accent stays inside that project's row and page. It exists nowhere else.",
        "section": "colors"
      },
      {
        "name": "The Italic Turn Rule",
        "body": "A heading gets one italic phrase at most, and it carries the point of the sentence.",
        "section": "typography"
      },
      {
        "name": "The Readout Rule",
        "body": "Facts that could be measured or dated are set in mono. Claims are set in serif.",
        "section": "typography"
      },
      {
        "name": "The Flat At Rest Rule",
        "body": "A shadow appears only on something that has been summoned.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep every interactive target at least 44px tall on touch, except inline references.",
      "Do give every animation a static version under reduced motion and without scripts.",
      "Do set dates, numbers, kinds and coordinates in Geist Mono.",
      "Do use the token that resolves per theme, so light and dark stay in step.",
      "Do keep hover movement to a few pixels."
    ],
    "donts": [
      "Don't make this look like a generic developer template.",
      "Don't use agent blue as decoration.",
      "Don't let a project's accent leave its row or page.",
      "Don't add shadows to surfaces at rest.",
      "Don't add a second heavy idea to the first viewport."
    ]
  }
}
