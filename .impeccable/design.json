      "name": "Work Row",
      "kind": "custom",
      "description": "Hairline row whose title shifts on hover.",
      "html": "<a class=\"ds-row\" href=\"#\"><span class=\"ds-n\">01</span><span class=\"ds-t\">Flag &amp; Fill</span><span class=\"ds-a\">→</span></a>",
      "css": ".ds-row{display:flex;align-items:baseline;gap:24px;padding:30px 0;border-top:1px solid var(--hairline,#d6d6d2);color:var(--ink,#141414);text-decoration:none}.ds-n{font:12px/1.6 'Geist Mono',monospace;color:var(--muted-ink,#5e5e5b)}.ds-t{font:400 52px/1 'Instrument Serif',serif;transition:transform .5s cubic-bezier(.16,1,.3,1)}.ds-a{margin-left:auto;font-size:22px;transition:transform .4s cubic-bezier(.16,1,.3,1)}.ds-row:hover .ds-t,.ds-row:focus-visible .ds-t{transform:translateX(12px)}.ds-row:hover .ds-a,.ds-row:focus-visible .ds-a{transform:rotate(-45deg)}.ds-row:focus-visible{outline:2px solid var(--agent,#2b4cc8);outline-offset:4px}"
