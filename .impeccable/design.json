  "components": [
    {
      "name": "Terminal Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Runs a hero terminal command.",
      "html": "<button class=\"ds-chip\">whoami</button> <button class=\"ds-chip ds-chip-on\">mission</button>",
      "css": ".ds-chip{min-height:44px;padding:0 12px;border:1px solid var(--hairline,#d6d6d2);border-radius:9999px;background:none;color:var(--muted-ink,#5e5e5b);font:12px/1.6 'Geist Mono',monospace;transition:color .2s,border-color .2s;cursor:pointer}.ds-chip:hover{color:var(--ink,#141414)}.ds-chip:focus-visible{outline:2px solid var(--agent,#2b4cc8);outline-offset:3px}.ds-chip-on{color:var(--agent,#2b4cc8);border-color:var(--agent,#2b4cc8)}"
    },
    {
      "name": "Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Static or linked proof tag.",
      "html": "<a class=\"ds-tag\" href=\"#\">Dean's List ↗</a>",
      "css": ".ds-tag{display:inline-flex;gap:6px;padding:6px 14px;border:1px solid var(--hairline,#d6d6d2);border-radius:9999px;color:var(--ink,#141414);font:12px/1.6 'Geist Mono',monospace;text-decoration:none;transition:border-color .2s}.ds-tag:hover{border-color:var(--ink,#141414)}.ds-tag:focus-visible{outline:2px solid var(--agent,#2b4cc8);outline-offset:3px}"
    },
