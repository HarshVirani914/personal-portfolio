# Production site URL (required for correct Open Graph / sitemap / canonical URLs)
NEXT_PUBLIC_SITE_URL=https://harsh-virani.vercel.app

# Sanity (leave unset to use the built-in fixture content)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed if the dataset is private
SANITY_API_READ_TOKEN=
# Same secret as configured on the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# Groq API key for the ⌘K agent. Without it the overlay says the agent is resting.
GROQ_API_KEY=
