# Public site URL. The one setting for canonical links, social cards and the sitemap.
# Change it to move to a custom domain. Previews fall back to their own URL.
NEXT_PUBLIC_SITE_URL=https://harsh-virani.vercel.app

# Sanity (leave unset to use the built-in fixture content)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed if the dataset is private
SANITY_API_READ_TOKEN=
# Same secret as configured on the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# Groq API key for the ⌘K agent. Without it the overlay says the agent is resting.
GROQ_API_KEY=
# Upstash Redis for the agent's cache, limits and log. Create it at
# console.upstash.com with no card on file: a card upgrades it to pay-as-you-go.
# Without these the agent makes no model calls.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
